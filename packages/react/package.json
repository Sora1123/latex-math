{
  "name": "@latex-math/react",
  "version": "1.0.1",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs && tsc --emitDeclarationOnly",
    "dev": "tsup src/index.tsx --format esm,cjs --watch"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@latex-math/core": "*",
    "mathlive": "^0.110.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Sora1123",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sora1123/latex-math.git"
  }
}
